{
  "name": "portfolio-apps",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "server": "node --env-file-if-exists=.env server/index.js",
    "dev": "concurrently --kill-others \"npm run server\" \"vite\"",
    "build": "vite build",
    "cloud:dev": "npm run build && wrangler dev --var COOKIE_SECURE:false",
    "cloud:check": "npm run build && wrangler deploy --dry-run",
    "cloud:secret": "node scripts/cloud-secret.mjs",
    "cloud:deploy": "npm run build && wrangler deploy --domains houseofabdi.web.id",
    "cloud:verify": "node scripts/verify-production.mjs",
    "firebase:provision": "node scripts/provision-firebase.mjs --free",
    "firebase:check": "node scripts/migrate-firebase.mjs",
    "firebase:migrate": "node scripts/migrate-firebase.mjs --apply",
    "firebase:migrate:free": "node scripts/migrate-firebase.mjs --apply --assets",
    "lint": "oxlint",
    "preview": "vite preview",
    "prod": "npm run build && node scripts/start-production.mjs",
    "serve": "npm run prod",
    "docker:build": "docker build -t portfolio-apps:latest .",
    "docker:run": "docker compose up --build -d",
    "docker:compose": "docker compose up --build -d",
    "test": "node --test tests/*.test.mjs",
    "storage:migrate": "node --env-file-if-exists=.env server/storage/migrateToS3.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "file-type": "^22.1.0",
    "iconv-lite": "^0.7.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.31.0",
    "multer": "^2.2.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.6.4"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^9.1.2",
    "oxlint": "^1.75.0",
    "vite": "^8.2.0",
    "wrangler": "^4.131.1"
  },
  "engines": {
    "node": ">=24"
  }
}
