# Node 24+. Copy this file to .env and customize your deployment.
# On first startup, omit ADMIN_PASSWORD to create .data/admin-bootstrap.txt locally.
# ADMIN_PASSWORD=use-a-new-password-with-at-least-12-characters
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:8080,http://127.0.0.1:8080
COOKIE_SECURE=false
# For HTTPS production: PUBLIC_ORIGIN=https://your-domain and COOKIE_SECURE=true.
# Frontend build setting when Pages and API Worker use different hostnames:
# VITE_API_BASE_URL=https://portfolio-api.<your-subdomain>.workers.dev
# Behind a trusted local reverse proxy only:
# TRUST_PROXY=loopback
STORAGE_DRIVER=local
MEDIA_QUOTA_BYTES=1073741824
# DATA_DIR=D:/private/portfolio-data
# UPLOADS_DIR=D:/private/portfolio-uploads
# For S3/R2 (set bucket policy/public domain separately; no ACL is applied):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=auto
# AWS_S3_ENDPOINT=https://your-account.r2.cloudflarestorage.com
# AWS_S3_BUCKET_NAME=portfolio-media
# AWS_S3_PUBLIC_DOMAIN=https://media.your-domain
