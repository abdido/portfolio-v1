{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "portfolio-apps",
  "main": "cloud/worker.js",
  "alias": {"iconv-lite":"./node_modules/iconv-lite/lib/index.js"},
  "compatibility_date": "2026-09-14",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/uploads/*"]
  },
  "vars": {
    "FIREBASE_PROJECT_ID": "portfolio-backend-fe034",
    "FIREBASE_STORAGE_BUCKET": "portfolio-backend-fe034.firebasestorage.app",
    "COOKIE_SECURE": "true",
    "MEDIA_QUOTA_BYTES": "1073741824",
    "MEDIA_STORAGE_DRIVER": "assets"
  },
  "observability": {
    "enabled": true,
    "logs": {"enabled": true, "head_sampling_rate": 1},
    "traces": {"enabled": true, "head_sampling_rate": 0.1}
  },
  "ratelimits": [
    {"name":"LOGIN_RATE_LIMIT","namespace_id":"1001","simple":{"limit":10,"period":60}},
    {"name":"CONTACT_RATE_LIMIT","namespace_id":"1002","simple":{"limit":5,"period":60}},
    {"name":"UPLOAD_RATE_LIMIT","namespace_id":"1003","simple":{"limit":20,"period":60}},
    {"name":"EVENT_RATE_LIMIT","namespace_id":"1004","simple":{"limit":120,"period":60}}
  ],
  "triggers": {"crons":["0 0 * * *"]}
}
